# Tracked release data: the episode-split manifest and the paper's result
# evidence are exempt from the blanket *.csv rule above.
!splits/*.csv
!pess_2026_rl_luce/evidence/*.csv
!pess_2026_rl_luce/evidence/first_trip_episodes/*.csv
!pess_2026_rl_luce/traceability.csv

# Never commit: run provenance with cluster-internal paths, and manuscript
# review material.
pess_2026_rl_luce/evidence/first_trip_definition.json
pess_2026_rl_luce/redline/
pess_2026_rl_luce/figure_data/
